## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# The root .gitignore excludes *.sln (it targets CMake-generated solutions).
# ison-cs.sln is hand-written source: without it `dotnet restore` in this
# directory finds no project or solution and CI fails.
!ison-cs.sln

# Visual Studio cache/options
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet
.nuget/
*.nupkg
*.snupkg

# Test Results
TestResults/
*.trx

# IDE settings
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
